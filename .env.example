# Copy to .env and set your endpoint and API keys.
AGENTIC_VLM_BASE_URL=https://your-endpoint.example/v1
AGENTIC_VLM_API_KEY=
AGENTIC_VLM_MODEL=gpt-5.6-luna
AGENTIC_AGENTS_SDK_MODEL_API=responses

# Optional answer scorer settings for open-ended answers.
# Leave blank to use the task agent's model and endpoint.
COEVOLVE_JUDGE_BASE_URL=
COEVOLVE_JUDGE_API_KEY=
COEVOLVE_JUDGE_MODEL=
COEVOLVE_JUDGE_API_SURFACE=

# FAL video generation.
AGENTIC_VWM_TOOL_BACKEND=fal_h3
AGENTIC_FAL_H3_EXECUTE=1
AGENTIC_FAL_H3_MAX_INFLIGHT=32
AGENTIC_FAL_H3_DURATION=5
AGENTIC_FAL_H3_RESOLUTION=480P
AGENTIC_FAL_H3_PROMPT_EXPANSION_MODE=balanced
FAL_KEY=
